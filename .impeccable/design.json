  "components": [
    {
      "name": "Primary Action",
      "kind": "button",
      "refersTo": "hero-primary",
      "description": "Home primary work action, with a 52px minimum height. Source: src/index.css hero-actions and controls; src/components/pages/home/Home.tsx; SVG: src/components/ArrowIcon.tsx.",
      "html": "<a class=\"ds-primary\" href=\"#work\">View work <svg class=\"ds-arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a>",
      "css": ".ds-primary{font-family:'Noto Sans Thai',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:var(--control-gap,8px);min-height:52px;padding:12px 24px;border-radius:var(--radius,8px);border:1px solid transparent;font-size:.875rem;font-weight:600;line-height:1.5;text-decoration:none;transition:background-color .2s,border-color .2s,color .2s,translate .2s var(--motion-ease,cubic-bezier(.16,1,.3,1));color:#14101f;background:var(--brand-gradient,linear-gradient(115deg,#a48aff 0%,#d6a5f6 45%,#a0e8ee 100%))}.ds-primary:is(:hover,:focus-visible){background:#ded3ff}.ds-primary:focus-visible{outline:2px solid var(--brand-cyan,#a0e8ee);outline-offset:5px}.ds-primary:active{translate:0 1px}.ds-arrow{display:inline-block;flex:0 0 auto;width:var(--icon-size,14px);height:var(--icon-size,14px);vertical-align:middle}@media(max-width:1100px){.ds-primary{padding-inline:14px;font-size:.8rem}}@media(max-width:767px){.ds-primary{padding-inline:16px}}@media(prefers-reduced-motion:no-preference){.ds-primary .ds-arrow{transition:translate .2s var(--motion-ease,cubic-bezier(.16,1,.3,1))}.ds-primary:is(:hover,:focus-visible) .ds-arrow{translate:1px -1px}}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Secondary Action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined actions for Home resume download and enabled contextual destinations on About; the resume new-tab action uses the shared compact arrow. Source: src/index.css controls and hero-actions; src/components/ResumeDownloadButton.tsx; src/components/pages/about/About.tsx; src/components/pages/resume/Resume.tsx.",
      "html": "<button class=\"ds-secondary\" type=\"button\">Download Résumé</button>",
      "css": ".ds-secondary{font-family:'Noto Sans Thai',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:var(--control-gap,8px);min-height:48px;padding:12px 16px;border-radius:var(--radius,8px);border:1px solid var(--border-strong,#514d60);font-size:.875rem;font-weight:600;line-height:1.5;text-decoration:none;transition:background-color .2s,border-color .2s,color .2s,translate .2s var(--motion-ease,cubic-bezier(.16,1,.3,1));color:var(--ink,#f3f1f8);background:transparent;cursor:pointer}.ds-secondary:is(:hover,:focus-visible){border-color:var(--brand-ink,#c6b5ff);background:#221d2e}.ds-secondary:focus-visible{outline:2px solid var(--brand-cyan,#a0e8ee);outline-offset:5px}.ds-secondary:active:not(:disabled){translate:0 1px}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}@media(max-width:1100px){.ds-secondary{padding-inline:14px;font-size:.8rem}}@media(max-width:767px){.ds-secondary{padding-inline:16px}}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Tertiary Contact Action",
      "kind": "button",
      "refersTo": "button-tertiary",
      "description": "Home text contact action beneath the primary work hierarchy. Source: src/components/pages/home/Home.tsx; src/index.css text-action rules.",
      "html": "<a class=\"ds-text-action\" href=\"#contact\">Contact <svg class=\"ds-arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a>",
      "css": ".ds-text-action{font-family:'Noto Sans Thai',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:var(--control-gap,8px);min-height:48px;padding:10px 12px;border-radius:var(--radius,8px);color:var(--muted,#aaa7b7);font-size:var(--support-size,.875rem);font-weight:500;text-decoration:none;transition:background-color .2s,color .2s}.ds-text-action:is(:hover,:focus-visible){color:var(--ink,#f3f1f8);background:var(--surface-elevated,#1c1b23)}.ds-text-action:focus-visible{outline:2px solid var(--brand-cyan,#a0e8ee);outline-offset:5px}.ds-text-action:active{translate:0 1px}.ds-arrow{display:inline-block;flex:0 0 auto;width:var(--icon-size,14px);height:var(--icon-size,14px);vertical-align:middle}@media(prefers-reduced-motion:reduce){.ds-text-action{transition:none}}"
    },
    {
      "name": "Boxed Skill Evidence",
      "kind": "custom",
      "refersTo": "skill-evidence",
      "description": "Home skills use boxed controls in three columns, two on mobile, and one below 360px. Skills tiles use four columns, three below 1024px, two below 768px, and one below 480px. Both link to the corresponding technology filter only when Projects is enabled; otherwise they are informational. Source: src/components/pages/home/Home.tsx; src/components/pages/skills/Skills.tsx; src/index.css developer-stack and skill rules.",
      "html": "<div class=\"ds-stack\"><a class=\"ds-skill\" href=\"#projects-typescript\">TypeScript <svg class=\"ds-arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a><a class=\"ds-skill\" href=\"#projects-react\">React <svg class=\"ds-arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a><span class=\"ds-skill\">Node.js</span></div><div class=\"ds-skill-grid\"><a class=\"ds-skill-tile\" href=\"#projects-typescript\"><span>TypeScript</span><svg class=\"ds-arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a><a class=\"ds-skill-tile\" href=\"#projects-react\"><span>React</span><svg class=\"ds-arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a></div>",
      "css": ".ds-stack,.ds-skill-grid{font-family:'Noto Sans Thai',sans-serif;display:grid;gap:12px}.ds-stack{grid-template-columns:repeat(3,minmax(0,1fr))}.ds-skill{display:inline-flex;align-items:center;gap:12px;min-height:64px;padding:16px 18px;border:1px solid var(--border-strong,#514d60);border-radius:var(--radius,8px);background:var(--surface,#151419);font-size:1rem;color:var(--ink,#f3f1f8);text-decoration:none;transition:background-color .2s,border-color .2s,color .2s}.ds-skill-grid{grid-template-columns:repeat(4,minmax(0,1fr));margin-top:12px}.ds-skill-tile{display:flex;align-items:center;gap:10px;min-width:0;min-height:72px;padding:16px;border:1px solid var(--border-strong,#514d60);border-radius:var(--radius,8px);background:var(--surface,#151419);color:var(--ink,#f3f1f8);font-size:.875rem;font-weight:600;text-decoration:none;transition:background-color .2s,border-color .2s,color .2s}.ds-skill-tile span{min-width:0;overflow-wrap:anywhere}a.ds-skill:is(:hover,:focus-visible),a.ds-skill-tile:is(:hover,:focus-visible){color:var(--brand-ink,#c6b5ff);border-color:var(--brand-ink,#c6b5ff);background:var(--surface-elevated,#1c1b23)}a.ds-skill:focus-visible,a.ds-skill-tile:focus-visible{outline:2px solid var(--brand-cyan,#a0e8ee);outline-offset:5px}a.ds-skill:active,a.ds-skill-tile:active{translate:0 1px}.ds-skill .ds-arrow,.ds-skill-tile .ds-arrow{color:var(--brand-ink,#c6b5ff)}.ds-arrow{display:inline-block;flex:0 0 auto;width:var(--icon-size,14px);height:var(--icon-size,14px);vertical-align:middle}@media(max-width:1023px){.ds-skill-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:767px){.ds-stack,.ds-skill-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ds-skill{font-size:.875rem;gap:8px}.ds-skill-tile{padding:14px;font-size:.8rem}}@media(max-width:479px){.ds-skill-grid{grid-template-columns:1fr}}@media(max-width:359px){.ds-stack{grid-template-columns:1fr}}@media(prefers-reduced-motion:no-preference){a.ds-skill .ds-arrow,a.ds-skill-tile .ds-arrow{transition:translate .2s var(--motion-ease,cubic-bezier(.16,1,.3,1))}a.ds-skill:is(:hover,:focus-visible) .ds-arrow,a.ds-skill-tile:is(:hover,:focus-visible) .ds-arrow{translate:1px -1px}}@media(prefers-reduced-motion:reduce){.ds-skill,.ds-skill-tile{transition:none}}"
    },
    {
