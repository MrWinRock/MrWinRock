      "html": "<input class=\"ds-field\" aria-label=\"Message\" placeholder=\"Your message\" />",
      "css": ".ds-field{font-family:'Noto Sans Thai',sans-serif;display:block;width:100%;min-height:50px;padding:13px 16px;background:#0e0d12;color:var(--ink,#f3f1f8);border:1px solid var(--border-strong,#514d60);border-radius:8px;line-height:1.7;caret-color:var(--brand-ink,#c6b5ff)}.ds-field::placeholder{color:#9d97ac;opacity:1}.ds-field:focus,.ds-field:focus-visible{outline:2px solid var(--brand-ink,#c6b5ff);outline-offset:2px}.ds-field[aria-invalid=true]{border-color:#f4a4bb}"
