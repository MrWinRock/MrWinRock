    {
      "name": "Catalog Navigation",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Active and resting navigation links. Source: src/components/Navbar.tsx; src/index.css navigation rules.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Preview navigation\"><a class=\"ds-nav-link\" href=\"#home\" aria-current=\"page\">Home</a><a class=\"ds-nav-link\" href=\"#projects\">Projects</a><a class=\"ds-nav-link\" href=\"#contact\">Contact</a></nav>",
      "css": ".ds-nav{font-family:'Noto Sans Thai',sans-serif;display:flex;align-items:center;gap:4px;min-height:var(--header-height,72px);padding:10px;background:#0c0c10;border-bottom:1px solid var(--border,#302e39)}.ds-nav-link{position:relative;display:inline-flex;align-items:center;min-height:44px;padding:8px 10px;font-size:.8125rem;line-height:1.75;color:var(--muted,#aaa7b7);border-radius:6px;text-decoration:none;transition:color .2s,background-color .2s}.ds-nav-link:hover{color:var(--ink,#f3f1f8);background:var(--surface,#151419)}.ds-nav-link[aria-current=page]{color:var(--brand-ink,#c6b5ff)}.ds-nav-link[aria-current=page]::after{content:'';position:absolute;bottom:2px;left:10px;right:10px;height:2px;border-radius:2px;background:var(--brand-ink,#c6b5ff)}.ds-nav-link:focus-visible{outline:2px solid var(--brand-cyan,#a0e8ee);outline-offset:5px}@media(max-width:767px){.ds-nav{min-height:var(--header-height,64px)}}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none}}"
    },
    {
      "name": "Technology Tags",
      "kind": "chip",
      "refersTo": "technology-tag",
      "description": "Shared boxed technology chips for project cards, project details, and Experience. Deduplicated labels link to project technology filters only when Projects is enabled; otherwise they are informational. Source: src/components/TechnologyTags.tsx; src/index.css tech-list and tech-chip rules.",
      "html": "<ul class=\"ds-tags\" aria-label=\"Technologies\"><li class=\"ds-tag\"><a class=\"ds-chip\" href=\"#projects-typescript\">TypeScript</a></li><li class=\"ds-tag\"><a class=\"ds-chip\" href=\"#projects-react\">React</a></li><li class=\"ds-tag\"><span class=\"ds-chip\">Node.js</span></li></ul>",
      "css": ".ds-tags{font-family:'Noto Sans Thai',sans-serif;display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}.ds-tag{display:inline-flex;min-width:0}.ds-chip{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:6px 12px;border:1px solid var(--border-strong,#514d60);border-radius:var(--radius,8px);color:var(--brand-ink,#c6b5ff);background:var(--surface-elevated,#1c1b23);font-size:.8125rem;line-height:1.5;overflow-wrap:anywhere;text-decoration:none;transition:color .2s,background-color .2s,border-color .2s,translate .2s var(--motion-ease,cubic-bezier(.16,1,.3,1))}a.ds-chip:is(:hover,:focus-visible){color:var(--ink,#f3f1f8);border-color:var(--brand-ink,#c6b5ff);background:#241c32}a.ds-chip:focus-visible{outline:2px solid var(--brand-cyan,#a0e8ee);outline-offset:5px}a.ds-chip:active{translate:0 1px}@media(prefers-reduced-motion:reduce){.ds-chip{transition:none}}"
    },
    {
      "name": "Open Project Row",
      "kind": "card",
      "refersTo": "project-row",
      "description": "Open catalog listing with a linked title, boxed technology filters, and compact exploration actions directly below the summary. Optional Home covers open the detail and sit beside the summary on desktop, above it on mobile; this preview has no cover. Source: src/components/pages/projects/ProjectCard.tsx; src/components/TechnologyTags.tsx; src/index.css project-card rules; SVG: src/components/ArrowIcon.tsx.",
      "html": "<article class=\"ds-project\"><div class=\"ds-project-body\"><div class=\"ds-project-info\"><div class=\"ds-summary\"><h3 class=\"ds-project-title\"><a class=\"ds-title-link\" href=\"#project\">Project title</a></h3><p class=\"ds-project-copy\">Published project description.</p><ul class=\"ds-project-tags\" aria-label=\"Technologies\"><li><a class=\"ds-project-chip\" href=\"#projects-typescript\">TypeScript</a></li></ul></div><div class=\"ds-project-links\"><a class=\"ds-detail\" href=\"#project\">View details <svg class=\"ds-arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></a></div></div></div></article>",
      "css": ".ds-project{font-family:'Noto Sans Thai',sans-serif;display:grid;padding:32px 0;background:transparent;border-block:1px solid var(--border,#302e39)}.ds-project-body{display:grid;grid-template-columns:minmax(0,1fr);gap:24px;align-items:start}.ds-project:hover,.ds-project:focus-within{background:#1c1726}.ds-project-info{display:grid;gap:24px;min-width:0}.ds-summary{min-width:0}.ds-project-title{font-family:var(--font-display,Sora,'Noto Sans Thai',sans-serif);font-size:1.65rem;font-weight:500;line-height:1.25;color:var(--ink,#f3f1f8);margin:0 0 12px}.ds-title-link{color:inherit;text-decoration:none;text-decoration-thickness:1px;text-underline-offset:.2em}.ds-title-link:is(:hover,:focus-visible){color:var(--brand-ink,#c6b5ff);text-decoration-line:underline}.ds-project-copy{max-width:68ch;color:var(--muted,#aaa7b7);line-height:1.85;font-size:.95rem;margin:0 0 18px}.ds-project-tags{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none}.ds-project-chip{display:inline-flex;align-items:center;justify-content:center;min-height:36px;padding:6px 12px;border:1px solid var(--border-strong,#514d60);border-radius:var(--radius,8px);color:var(--brand-ink,#c6b5ff);background:var(--surface-elevated,#1c1b23);font-size:.8125rem;line-height:1.5;text-decoration:none;transition:color .2s,background-color .2s,border-color .2s}.ds-project-chip:is(:hover,:focus-visible){color:var(--ink,#f3f1f8);border-color:var(--brand-ink,#c6b5ff);background:#241c32}.ds-project-links{display:flex;flex-wrap:wrap;align-items:center;gap:12px}.ds-detail{display:inline-flex;align-items:center;justify-content:center;gap:var(--control-gap,8px);width:fit-content;min-height:44px;padding:10px 14px;border:1px solid var(--border-strong,#514d60);border-radius:var(--radius,8px);background:var(--brand-wash,linear-gradient(120deg,#231b39,#18292e));font-size:.85rem;font-weight:600;color:var(--brand-ink,#c6b5ff);text-decoration:none;transition:color .2s,background-color .2s,border-color .2s}.ds-detail:is(:hover,:focus-visible){color:var(--ink,#f3f1f8);border-color:var(--brand-ink,#c6b5ff);background:var(--surface-elevated,#1c1b23)}.ds-detail:active,.ds-project-chip:active{translate:0 1px}.ds-detail:focus-visible,.ds-title-link:focus-visible,.ds-project-chip:focus-visible{outline:2px solid var(--brand-cyan,#a0e8ee);outline-offset:5px}.ds-arrow{display:inline-block;flex:0 0 auto;width:var(--icon-size,14px);height:var(--icon-size,14px);vertical-align:middle}.ds-showcase{padding:36px 0;transition:background-color .22s}.ds-showcase .ds-project-title{font-size:2rem}.ds-showcase.ds-with-cover .ds-project-body{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:24px 56px;align-items:start}.ds-showcase.ds-with-cover .ds-project-info{align-self:center}.ds-showcase.ds-with-cover .ds-cover-link{display:block;grid-column:2;align-self:center;border-radius:12px;overflow:hidden;background:var(--surface,#151419)}.ds-cover-link:is(:hover,:focus-visible){outline:2px solid var(--brand-ink,#c6b5ff);outline-offset:4px}.ds-cover{display:block;width:100%;max-height:380px;object-fit:contain;object-position:left;border-radius:12px}@media(max-width:767px){.ds-project,.ds-showcase{padding:28px 0}.ds-project-body{grid-template-columns:1fr;gap:20px}.ds-project-links{gap:8px}.ds-detail{max-width:250px}.ds-showcase .ds-project-title{font-size:1.7rem}.ds-project-copy{font-size:.9rem}.ds-showcase.ds-with-cover .ds-project-body{grid-template-columns:1fr;gap:24px}.ds-showcase.ds-with-cover .ds-project-info,.ds-showcase.ds-with-cover .ds-cover-link{grid-column:1;grid-row:auto}.ds-showcase.ds-with-cover .ds-cover-link{order:-1;width:100%}.ds-cover{max-height:320px}}@media(prefers-reduced-motion:no-preference){.ds-detail .ds-arrow{transition:translate .2s var(--motion-ease,cubic-bezier(.16,1,.3,1))}.ds-detail:is(:hover,:focus-visible) .ds-arrow{translate:1px -1px}}@media(prefers-reduced-motion:reduce){.ds-showcase,.ds-detail,.ds-project-chip{transition:none}}"
    },
    {
      "name": "Evidence Panel",
      "kind": "card",
      "refersTo": "evidence-panel",
      "description": "Enclosed reading container used where evidence needs grouping. Source: src/index.css surface-panel and evidence-panel rules.",
      "html": "<section class=\"ds-panel\"><h2 class=\"ds-panel-title\">Project evidence</h2><p class=\"ds-panel-copy\">Available technical decisions and contribution details appear here.</p></section>",
      "css": ".ds-panel{font-family:'Noto Sans Thai',sans-serif;position:relative;padding:32px;border:1px solid var(--border,#302e39);border-radius:16px;background:var(--surface,#151419);min-width:0;transition:border-color .2s}.ds-panel:focus-within{border-color:var(--border-strong,#514d60)}.ds-panel-title{font-family:var(--font-display,Sora,'Noto Sans Thai',sans-serif);font-size:1.4rem;font-weight:500;line-height:1.25;letter-spacing:-.035em;color:var(--ink,#f3f1f8);margin:0 0 18px}.ds-panel-copy{color:var(--muted,#aaa7b7);max-width:70ch;line-height:1.9;margin:0}@media(max-width:767px){.ds-panel{padding:24px}}@media(prefers-reduced-motion:reduce){.ds-panel{transition:none}}"
    },
    {
      "name": "Direct Contact Link",
      "kind": "card",
      "refersTo": "direct-contact",
      "description": "Boxed contact destination with a compact arrow beside its label and a wrapping address. Source: src/components/pages/contact/Contact.tsx; src/index.css direct-link rules.",
      "html": "<a class=\"ds-direct\" href=\"mailto:hello@example.com\"><span class=\"ds-contact-icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/></svg></span><span class=\"ds-direct-copy\"><span class=\"ds-direct-label\">Email <svg class=\"ds-arrow\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></span><span class=\"ds-direct-value\">hello@example.com</span></span></a>",
      "css": ".ds-direct{font-family:'Noto Sans Thai',sans-serif;display:flex;align-items:center;gap:16px;padding:16px;border:1px solid var(--border,#302e39);border-radius:var(--radius,8px);background:var(--surface,#151419);color:var(--ink,#f3f1f8);text-decoration:none;overflow-wrap:anywhere;transition:border-color .2s,background-color .2s}.ds-contact-icon{display:grid;place-items:center;flex-shrink:0;width:40px;height:40px;border-radius:8px;background:#ffffff0d;color:var(--brand-ink,#c6b5ff)}.ds-direct-copy{min-width:0}.ds-direct-label{display:inline-flex;align-items:center;gap:8px;font-size:.875rem;font-weight:500;color:#fff}.ds-direct-label .ds-arrow{color:var(--brand-ink,#c6b5ff)}.ds-direct-value{display:block;font-size:.75rem;color:#99a1af;overflow-wrap:anywhere}.ds-direct:is(:hover,:focus-visible){color:var(--brand-ink,#c6b5ff);border-color:var(--brand-ink,#c6b5ff);background:var(--surface-elevated,#1c1b23)}.ds-direct:hover .ds-contact-icon{color:#fff}.ds-direct:focus-visible{outline:2px solid var(--brand-cyan,#a0e8ee);outline-offset:5px}.ds-arrow{display:inline-block;flex:0 0 auto;width:var(--icon-size,14px);height:var(--icon-size,14px);vertical-align:middle}@media(prefers-reduced-motion:no-preference){.ds-direct .ds-arrow{transition:translate .2s var(--motion-ease,cubic-bezier(.16,1,.3,1))}.ds-direct:is(:hover,:focus-visible) .ds-arrow{translate:1px -1px}}@media(prefers-reduced-motion:reduce){.ds-direct{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "The Independent Catalog",
    "overview": "The system treats personal work as a catalog: clear names, open listings, fine rules, and enough space to inspect the evidence. Ink-dark fields and cool lettering provide a quiet reading surface; the original skull anchors recognition inside an expressive gradient sleeve.\n\nThis name, the descriptive color names, and the named rules below are designer decisions made under the owner's delegated visual brief. The durable owner commitments are the MrWinRock identity, the existing skull, dark surfaces, gradients, and useful English and Thai journeys. Sora supplies the display voice while Noto Sans Thai carries reading and Thai coverage.",
    "keyCharacteristics": [
      "Ink-dark reading surfaces and cool, solid-color text.",
      "Original skull artwork on a violet, lilac, and cyan sleeve.",
      "Open project rows, fine dividers, and restrained tonal states.",
      "Bilingual typography, visible focus, and static reduced-motion behavior."
    ],
    "rules": [
      {
        "name": "The Material Gradient Rule",
        "body": "Put gradients on sleeves, action fills, and broad contact surfaces; keep reading text a solid color.",
        "section": "colors"
      },
      {
        "name": "The Two-Script Rule",
        "body": "Preserve the Noto Sans Thai fallback in display stacks and its reading role; test both languages when changing type size or width.",
        "section": "typography"
      },
      {
        "name": "The Open Catalog Rule",
        "body": "Present work listings as open rows separated by fine rules; use enclosed panels for evidence, fields, and resource states where grouping earns its boundary.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the original skull and dark, gradient-bearing identity.",
      "**Do** use solid readable text, fine rules, and open work listings.",
      "**Do** preserve both language stacks, visible focus, and reduced-motion behavior.",
      "**Do** derive future component variants from the observed source and verify their responsive reading order."
    ],
    "donts": [
      "**Don't** turn reading text into gradient lettering.",
      "**Don't** apply the skull's shadow as a general panel elevation.",
      "**Don't** gate content behind decorative animation or add a continuous sleeve loop.",
      "**Don't** infer new project evidence or product claims from visual examples."
    ]
  }
}
